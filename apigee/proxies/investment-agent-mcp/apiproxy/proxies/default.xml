<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <Description/>
    <FaultRules/>
    <PreFlow name="PreFlow">
        <Request/>
        <Response/>
    </PreFlow>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <Flows/>
    <HTTPProxyConnection>
        <BasePath>/mcp</BasePath>
        <Properties/>
    </HTTPProxyConnection>
    <RouteRule name="get_market_snapshot">
        <Condition>(proxy.pathsuffix MatchesPath "/get_market_snapshot")</Condition>
        <TargetEndpoint>get-portfolio</TargetEndpoint>
    </RouteRule>
    <RouteRule name="calculate_orders">
        <Condition>(proxy.pathsuffix MatchesPath "/calculate_orders")</Condition>
        <TargetEndpoint>calculate-allocations</TargetEndpoint>
    </RouteRule>
    <RouteRule name="check_financial_health">
        <Condition>(proxy.pathsuffix MatchesPath "/check_financial_health")</Condition>
        <TargetEndpoint>check-financial-health</TargetEndpoint>
    </RouteRule>
    <RouteRule name="get_market_news">
        <Condition>(proxy.pathsuffix MatchesPath "/get_market_news")</Condition>
        <TargetEndpoint>get-market-news</TargetEndpoint>
    </RouteRule>
    <RouteRule name="default">
        <TargetEndpoint>get-portfolio</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>
