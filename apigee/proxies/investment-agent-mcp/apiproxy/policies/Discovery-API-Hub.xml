<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ServiceCallout async="false" continueOnError="false" enabled="true" name="Discovery-API-Hub">
    <DisplayName>Discovery API Hub</DisplayName>
    <Request clearPayload="true" variable="apihubRequest">
        <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
        <Set>
            <Verb>GET</Verb>
        </Set>
    </Request>
    <Response>apihubResponse</Response>
    <HTTPTargetConnection>
        <Authentication>
            <GoogleAccessToken>
                <Scopes>
                    <Scope>https://www.googleapis.com/auth/cloud-platform</Scope>
                </Scopes>
            </GoogleAccessToken>
        </Authentication>
        <URL>https://apihub.googleapis.com/v1/projects/{organization.name}/locations/us-east4/apis</URL>
    </HTTPTargetConnection>
</ServiceCallout>
